{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-09-29/server.schema.json",
  "name": "co.policyforge/mcp",
  "description": "Generate, audit, and maintain legal policies that match what your code actually does.",
  "status": "active",
  "version": "0.6.0",
  "websiteUrl": "https://policyforge.co",
  "repository": {
    "url": "https://github.com/PolicyForge/mcp",
    "source": "github"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://policyforge.co/api/mcp"
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@policyforge/mcp",
      "version": "0.6.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "POLICYFORGE_API_KEY",
          "description": "PolicyForge API key — create one at https://policyforge.co/api-dashboard",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
